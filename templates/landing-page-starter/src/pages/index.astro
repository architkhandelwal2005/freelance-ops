---
// Replace every fictional value with client-approved facts before delivery.
const brand = 'Nila Studio';
const title = 'A calmer place for your daily work';
const description = 'Fictional sample landing page for a compact desk concept.';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content={description}><title>{brand} | {title}</title><style>
:root{font:18px/1.55 system-ui;color:#173a33;background:#f6f5ef}*{box-sizing:border-box}body{margin:0}header,main,footer{max-width:1050px;margin:auto;padding:24px}header{display:flex;justify-content:space-between}.hero{min-height:65vh;display:grid;align-content:center}.hero h1{font-size:clamp(2.7rem,7vw,5.8rem);line-height:1.02;max-width:780px;margin:.2em 0}.button{display:inline-block;background:#173a33;color:white;padding:14px 20px;border-radius:6px;text-decoration:none;font-weight:700}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}.card{background:white;border:1px solid #d9e0d6;border-radius:8px;padding:22px}section{margin-block:50px}a:focus-visible{outline:3px solid #d99d60;outline-offset:3px}
</style></head><body><header><strong>{brand}</strong><a href="#contact">Contact</a></header><main><section class="hero"><p>Fictional landing page sample</p><h1>{title}</h1><p>{description}</p><p><a class="button" href="#contact">Discuss the concept</a></p></section><section><h2>Three clear reasons</h2><div class="cards"><article class="card"><h3>Focused</h3><p>Explain one approved benefit here.</p></article><article class="card"><h3>Practical</h3><p>Explain how the product works here.</p></article><article class="card"><h3>Considered</h3><p>Give a concrete use case here.</p></article></div></section><section id="contact"><h2>Next step</h2><p>Add the client's approved contact or checkout route here. No form transmits data in this starter.</p></section></main><footer>Fictional starter · built with AI tools, checked by hand.</footer></body></html>
