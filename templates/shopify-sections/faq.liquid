<section class="fo-faq" aria-labelledby="fo-faq-title-{{ section.id }}"><h2 id="fo-faq-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><div>{{ block.settings.answer }}</div></details>{% endfor %}</section>
{% if section.blocks.size > 0 %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for block in section.blocks %}{"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}{% unless forloop.last %},{% endunless %}{% endfor %}]}</script>{% endif %}
<style>.fo-faq{max-width:55rem;margin:auto;padding:3rem 1rem}.fo-faq details{border-bottom:1px solid #ddd;padding:1rem 0}.fo-faq summary{cursor:pointer;font-weight:700}</style>
{% schema %}{"name":"FO FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"Questions"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question"},{"type":"richtext","id":"answer","label":"Answer"}]}],"presets":[{"name":"FO FAQ"}]}{% endschema %}
