{% comment %}Copy to a staging theme. Use only merchant-approved text and images.{% endcomment %}
<section class="fo-hero" aria-labelledby="fo-hero-title-{{ section.id }}">
  <div class="fo-hero__copy"><p>{{ section.settings.eyebrow | escape }}</p><h2 id="fo-hero-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2><div>{{ section.settings.body }}</div>{% if section.settings.cta_url != blank %}<a href="{{ section.settings.cta_url }}">{{ section.settings.cta_label | escape }}</a>{% endif %}</div>
  {% if section.settings.image != blank %}{% assign fo_alt = section.settings.image.alt | default: section.settings.heading %}<div class="fo-hero__image">{{ section.settings.image | image_url: width: 1200 | image_tag: alt: fo_alt, loading: 'lazy' }}</div>{% endif %}
</section>
<style>.fo-hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:2rem;padding:3rem 1rem}.fo-hero__copy{max-width:42rem}.fo-hero__copy h2{font-size:clamp(2rem,5vw,4.5rem);line-height:1.1}.fo-hero__copy a{display:inline-block;padding:.8rem 1.3rem;background:#173a33;color:#fff}.fo-hero__image img{display:block;width:100%;height:auto}@media(max-width:700px){.fo-hero{grid-template-columns:1fr}}</style>
{% schema %}{"name":"FO hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading","default":"Approved heading"},{"type":"richtext","id":"body","label":"Body"},{"type":"text","id":"cta_label","label":"Button text"},{"type":"url","id":"cta_url","label":"Button link"},{"type":"image_picker","id":"image","label":"Image"}],"presets":[{"name":"FO hero"}]}{% endschema %}
