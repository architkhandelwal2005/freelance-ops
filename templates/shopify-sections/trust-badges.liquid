{% comment %}Only use merchant-approved claims. Do not add unsupported delivery, safety or guarantee statements.{% endcomment %}
<section class="fo-trust" aria-label="Store information">{% for block in section.blocks %}<div class="fo-trust__item" {{ block.shopify_attributes }}><strong>{{ block.settings.heading | escape }}</strong><span>{{ block.settings.detail | escape }}</span></div>{% endfor %}</section>
<style>.fo-trust{display:flex;flex-wrap:wrap;justify-content:center;gap:1.5rem;padding:2rem 1rem;border-block:1px solid #ddd}.fo-trust__item{display:grid;gap:.2rem;min-width:11rem;text-align:center}</style>
{% schema %}{"name":"FO store information","settings":[],"blocks":[{"type":"item","name":"Approved statement","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"text","id":"detail","label":"Detail"}]}],"presets":[{"name":"FO store information"}]}{% endschema %}
